---
import { type Language } from '../../lib/i18n';
import { route } from '../../lib/routes';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Tag from '../ui/Tag.astro';

interface Props { lang: Language; }
const { lang } = Astro.props;

const heading = lang === 'fr' ? 'Page hors itinéraire' : 'Page off-route';
const body = lang === 'fr'
  ? "La page ou la ressource que vous recherchez n'existe pas ou a été déplacée."
  : 'The page or resource you are looking for does not exist or has been moved.';
const homeLabel = lang === 'fr' ? 'Retour à l\'accueil' : 'Back to home';
const projectsLabel = lang === 'fr' ? 'Voir les projets' : 'View projects';
const contactLabel = lang === 'fr' ? 'Contact' : 'Contact';
---

<Section variant="canvas" class="min-h-[70vh] flex items-center justify-center">
  <Container>
    <div class="max-w-xl mx-auto text-center space-y-6">
      <Tag variant="magenta">404 · {lang === 'fr' ? 'ROUTE INTROUVABLE' : 'ROUTE NOT FOUND'}</Tag>
      <h1 class="font-heading text-4xl sm:text-5xl font-extrabold text-ink">{heading}</h1>
      <p class="text-base text-ink-muted leading-relaxed">{body}</p>
      <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
        <Button href={route('home', lang)} variant="primary">{homeLabel}</Button>
        <Button href={route('projects', lang)} variant="outline">{projectsLabel}</Button>
        <Button href={route('contact', lang)} variant="ghost">{contactLabel}</Button>
      </div>
    </div>
  </Container>
</Section>
