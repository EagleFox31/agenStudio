---
import { translations, type Language } from '../../lib/i18n';
import { route, projectPath } from '../../lib/routes';
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';
import HeroVisual from './HeroVisual.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = translations[lang];
const h = t.hero;
const f = t.frictions;
const e = t.expertises;
const p = t.projects;
const m = t.method;
const studio = t.studioIntro;

const contactHref = route('contact', lang);
const projectsHref = route('projects', lang);
const expertisesHref = route('expertises', lang);
const studioHref = route('studio', lang);

const projects = (await getCollection('projects'))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<!-- 01. HERO -->
<Section variant="canvas" class="pt-10 pb-16 md:pt-16 md:pb-24 border-b border-ink/10">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <div class="lg:col-span-7 space-y-6">
        <span class="inline-flex items-center gap-2 bg-teal/10 border border-teal/20 px-3 py-1 rounded-full text-xs font-mono text-teal">
          <span class="w-2 h-2 rounded-full bg-teal" aria-hidden="true"></span>
          <span>{h.badge}</span>
        </span>

        <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-ink leading-[1.1] tracking-tight">
          {h.title}
        </h1>
        {
          h.tagline ? (
            <p class="mt-3 font-serif-italic text-teal text-xl sm:text-2xl font-normal tracking-normal">
              {h.tagline}
            </p>
          ) : null
        }

        <p class="font-heading font-semibold text-lg sm:text-xl text-teal leading-snug">
          {h.subtitle}
        </p>

        {
          h.description ? (
            <p class="text-base sm:text-lg text-ink-muted leading-relaxed max-w-2xl">
              {h.description}
            </p>
          ) : null
        }

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <Button href={contactHref} variant="primary" size="lg">{h.primaryCta}</Button>
          <Button href={projectsHref} variant="outline" size="lg">{h.secondaryCta}</Button>
        </div>
      </div>

      <div class="lg:col-span-5">
        <HeroVisual lang={lang} />
      </div>
    </div>
  </Container>
</Section>

<!-- 02. FRICTIONS -->
<Section variant="white" class="border-b border-ink/10">
  <Container>
    <div class="max-w-3xl mb-12">
      <Tag variant="bordeaux" class="mb-3">{f.tag}</Tag>
      <h2 class="font-heading text-2xl sm:text-3xl md:text-4xl font-bold text-ink leading-tight">
        {f.title}
      </h2>
      <p class="text-ink-muted text-base sm:text-lg mt-3">{f.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      {
        t.frictions.items.map((item, idx) => (
          <div class="reveal h-full" style={`--reveal-delay: ${idx * 80}ms`}>
            <Card variant="light" class="h-full flex flex-col justify-between hover:border-bordeaux/30">
              <div class="space-y-3">
                <span class="inline-flex w-10 h-10 rounded-lg bg-bordeaux/10 text-bordeaux items-center justify-center text-lg font-mono font-bold">
                  !
                </span>
                <h3 class="font-heading font-bold text-lg text-ink">{item.title}</h3>
                <p class="text-sm text-ink-muted leading-relaxed">{item.description}</p>
              </div>
              <div class="mt-6 pt-4 border-t border-ink/10">
                <p class="font-mono text-xs text-bordeaux font-bold">{f.impactLabel} : {item.impact}</p>
              </div>
            </Card>
          </div>
        ))
      }
    </div>

    <div class="bg-ink text-white p-6 sm:p-8 rounded-xl border border-teal/30 flex items-center justify-between gap-4 flex-wrap">
      <blockquote class="font-heading font-semibold text-base sm:text-lg text-canvas italic">
        &ldquo;{f.quote}&rdquo;
      </blockquote>
      <Tag variant="gold" class="shrink-0">{f.principleLabel}</Tag>
    </div>
  </Container>
</Section>

<!-- 03. EXPERTISES PREVIEW -->
<Section variant="canvas" class="border-b border-ink/10">
  <Container>
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div>
        <Tag variant="teal" class="mb-3">{e.tag}</Tag>
        <h2 class="font-heading text-2xl sm:text-3xl md:text-4xl font-bold text-ink">
          {e.title}
        </h2>
        <p class="text-ink-muted text-base mt-2 max-w-xl">{e.subtitle}</p>
      </div>
      <Button href={expertisesHref} variant="outline" size="sm">{e.seeAll}</Button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        e.items.map((item, idx) => (
          <div class="reveal h-full" style={`--reveal-delay: ${idx * 80}ms`}>
            <Card variant="light" class="h-full flex flex-col justify-between">
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <Tag variant="teal">{`0${idx + 1}`}</Tag>
                  <span class="font-mono text-xs text-ink-light uppercase">
                    {e.capabilityLabel}
                  </span>
                </div>
                <h3 class="font-heading font-bold text-xl text-ink">{item.title}</h3>
                <div class="space-y-2 text-sm text-ink-muted">
                  <p><strong class="text-ink">{e.problemLabel} :</strong> {item.problem}</p>
                  <p><strong class="text-teal">{e.deliverableLabel} :</strong> {item.deliverable}</p>
                </div>
                <div class="p-3 bg-teal/5 rounded-lg border border-teal/15 text-xs text-teal-deep">
                  <strong>{e.benefitLabel} :</strong> {item.benefit}
                </div>
              </div>
              <div class="mt-6 pt-4 border-t border-ink/10 flex items-center justify-between">
                <span class="text-xs font-mono text-ink-light truncate max-w-[240px]">
                  {e.exampleLabel} : {item.example}
                </span>
                <a
                  href={`${expertisesHref}#${item.id}`}
                  class="text-xs font-mono text-teal font-semibold hover:underline"
                >
                  {e.detailsLabel} →
                </a>
              </div>
            </Card>
          </div>
        ))
      }
    </div>
  </Container>
</Section>

<!-- 04. SELECTED PROJECTS -->
<Section variant="white" class="border-b border-ink/10">
  <Container>
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div>
        <Tag variant="gold" class="mb-3">{p.tag}</Tag>
        <h2 class="font-heading text-2xl sm:text-3xl md:text-4xl font-bold text-ink">
          {p.title}
        </h2>
        <p class="text-ink-muted text-base mt-2 max-w-xl">{p.subtitle}</p>
      </div>
      <Button href={projectsHref} variant="secondary" size="sm">{p.exploreCases}</Button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        projects.map((project, idx) => (
          <div class="reveal h-full" style={`--reveal-delay: ${idx * 80}ms`}>
            <Card variant="light" class="h-full flex flex-col justify-between">
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <Tag variant="ink">{project.sector[lang]}</Tag>
                  <Tag
                    variant={
                      project.type === 'internal'
                        ? 'teal'
                        : project.type === 'rd'
                          ? 'magenta'
                          : project.type === 'client'
                            ? 'bordeaux'
                            : 'gold'
                    }
                  >
                    {p.types[project.type]}
                  </Tag>
                </div>
                <h3 class="font-heading font-bold text-lg text-ink leading-snug">
                  {project.title[lang]}
                </h3>
                <p class="text-xs text-ink-muted leading-relaxed">{project.subtitle[lang]}</p>
                <div class="flex flex-wrap gap-1.5 pt-2">
                  {project.stack.slice(0, 3).map((tech) => (
                    <span class="px-2 py-0.5 rounded bg-ink/5 text-ink text-[10px] font-mono">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
              <div class="mt-6 pt-4 border-t border-ink/10 flex items-center justify-between">
                <span class="text-[11px] font-mono text-teal font-medium">
                  {project.statusLabel[lang]}
                </span>
                <a
                  href={projectPath(project.slug, lang)}
                  class="inline-flex items-center gap-1 text-xs font-semibold text-ink hover:text-teal"
                >
                  <span>{p.consultLabel}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </Card>
          </div>
        ))
      }
    </div>
  </Container>
</Section>

<!-- 05. METHOD -->
<Section variant="dark" class="border-b border-white/10">
  <Container>
    <div class="max-w-2xl mb-12">
      <Tag variant="teal" class="mb-3">{m.tag}</Tag>
      <h2 class="font-heading text-2xl sm:text-3xl md:text-4xl font-bold text-white">
        {m.title}
      </h2>
      <p class="text-ink-light text-base mt-2">{m.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        m.steps.map((step, idx) => (
          <div
            class="reveal h-full p-6 rounded-2xl border border-white/10 bg-white/5 flex flex-col justify-between"
            style={`--reveal-delay: ${idx * 80}ms`}
          >
              <div class="space-y-3">
                <span class="font-mono text-sm font-bold px-3 py-1 rounded-md bg-teal text-white inline-block">
                  {step.number}
                </span>
                <h3 class="font-heading font-bold text-lg text-white">{step.title}</h3>
                <p class="text-sm text-ink-light leading-relaxed">{step.description}</p>
              </div>
              <div class="pt-4 mt-4 border-t border-white/10 text-xs font-mono text-teal">
                {m.outcomeLabel} : {step.outcome}
              </div>
          </div>
        ))
      }
    </div>
  </Container>
</Section>

<!-- 06. POINT OF VIEW -->
<Section variant="canvas" class="border-b border-ink/10">
  <Container>
    <div class="max-w-2xl mb-12">
      <Tag variant="magenta" class="mb-3">{t.pov.tag}</Tag>
      <h2 class="font-heading text-2xl sm:text-3xl md:text-4xl font-bold text-ink">
        {t.pov.title}
      </h2>
      <p class="text-ink-muted text-base mt-2">{t.pov.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        t.pov.cards.map((card, idx) => (
          <div class="reveal h-full" style={`--reveal-delay: ${idx * 80}ms`}>
            <Card variant="light" class="h-full">
              <div class="w-8 h-8 rounded bg-ink text-teal flex items-center justify-center mb-4 font-mono text-sm font-bold">
                {String(idx + 1).padStart(2, '0')}
              </div>
              <h3 class="font-heading font-bold text-lg text-ink mb-2">{card.title}</h3>
              <p class="text-sm text-ink-muted leading-relaxed">{card.body}</p>
            </Card>
          </div>
        ))
      }
    </div>
  </Container>
</Section>

<!-- 07. STUDIO TEASER -->
<Section variant="white" class="border-b border-ink/10">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-6 space-y-6">
        <Tag variant="teal">{studio.tag}</Tag>
        <h2 class="font-heading text-2xl sm:text-3xl md:text-4xl font-bold text-ink">
          {studio.title}
        </h2>
        <p class="text-ink-muted text-base sm:text-lg leading-relaxed">
          {studio.description}
        </p>

        <div class="space-y-3 pt-2">
          {
            studio.values.map((v, idx) => (
              <div class="p-4 rounded-xl border border-ink/10 bg-canvas flex items-start gap-3">
                <span class="w-6 h-6 rounded-md bg-teal/10 text-teal flex items-center justify-center shrink-0 mt-0.5 font-mono text-xs font-bold">
                  {String(idx + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="font-heading font-bold text-sm text-ink">{v.title}</h3>
                  <p class="text-xs text-ink-muted mt-0.5">{v.desc}</p>
                </div>
              </div>
            ))
          }
        </div>

        <div class="p-4 bg-canvas rounded-lg border border-ink/10 text-xs font-mono text-teal flex items-center gap-2">
          <span aria-hidden="true">📍</span>
          <span>{studio.anchorage}</span>
        </div>

        <Button href={studioHref} variant="primary">{studio.cta}</Button>
      </div>

      <div class="lg:col-span-6">
        <div class="rounded-2xl border border-teal/30 bg-ink text-white p-8 space-y-6 relative overflow-hidden min-h-[420px] flex flex-col justify-between">
          <div class="absolute inset-0 bg-dots-pattern opacity-10 pointer-events-none" aria-hidden="true"></div>
          <div class="relative z-10 space-y-3">
            <span class="font-mono text-xs text-teal uppercase tracking-widest">
              {studio.craftKicker}
            </span>
            <p class="font-heading text-2xl leading-snug text-white">
              {studio.craftLead}
            </p>
          </div>

          <ul class="relative z-10 grid grid-cols-2 gap-3 text-xs font-mono text-ink-light">
            <li class="p-3 border border-white/10 rounded-lg">
              <div class="text-teal font-bold">{studio.craftPhoneLabel}</div>
              <div>{studio.craftMobile}</div>
            </li>
            <li class="p-3 border border-white/10 rounded-lg">
              <div class="text-teal font-bold">{studio.craftNetLabel}</div>
              <div>{studio.craftPerf}</div>
            </li>
            <li class="p-3 border border-white/10 rounded-lg">
              <div class="text-teal font-bold">{studio.craftLiveLabel}</div>
              <div>{studio.craftTs}</div>
            </li>
            <li class="p-3 border border-white/10 rounded-lg">
              <div class="text-teal font-bold">{studio.craftLangLabel}</div>
              <div>{studio.craftI18n}</div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </Container>
</Section>

<!-- 08. FINAL CTA -->
<Section variant="teal">
  <Container>
    <div class="max-w-3xl mx-auto text-center space-y-6">
      <h2 class="font-heading text-2xl sm:text-3xl md:text-4xl font-bold text-white">
        {t.finalCta.title}
      </h2>
      <p class="text-white/80 text-base sm:text-lg">{t.finalCta.subtitle}</p>
      <div class="pt-4 flex items-center justify-center">
        <Button href={contactHref} variant="secondary" size="lg">
          {t.finalCta.button}
        </Button>
      </div>
      <p class="text-xs font-mono text-white/70 pt-2">{t.finalCta.altContact}</p>
    </div>
  </Container>
</Section>
