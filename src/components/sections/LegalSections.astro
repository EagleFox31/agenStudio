---
import { type Language } from '../../lib/i18n';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Tag from '../ui/Tag.astro';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;

const copy =
  lang === 'fr'
    ? {
        heading: 'Mentions légales',
        kicker: 'INFORMATIONS ÉDITORIALES',
        updated:
          "Dernière mise à jour : août 2026 — Statut : à valider selon l'immatriculation et le conseil juridique.",
        s1Title: '1. Éditeur du site',
        s1Body:
          'Le présent site est édité par AgenStudio, studio numérique indépendant basé au Cameroun (Douala / Yaoundé). Raison sociale, forme juridique et numéro d’immatriculation : à valider.',
        s1Contact: 'Contact e-mail : contact@agenstudio.com',
        s2Title: '2. Hébergement & infrastructure',
        s2Body:
          'Hébergement : Cloudflare Pages (Cloudflare, Inc., San Francisco, CA, États-Unis). Formulaire de contact : Cloudflare Turnstile et Resend — voir la politique de confidentialité.',
        s3Title: '3. Propriété intellectuelle',
        s3Body:
          "L'ensemble des contenus, visuels, concepts d'interface et codes sources sont la propriété exclusive d'AgenStudio, sauf mention contraire explicite.",
        s4Title: '4. Responsable du traitement',
        s4Body:
          'Pour les données du formulaire de contact : AgenStudio — identité complète à valider avec le conseiller juridique.',
      }
    : {
        heading: 'Legal Notice',
        kicker: 'PUBLISHER INFORMATION',
        updated:
          'Last update: August 2026 — Status: to be validated against registration and legal counsel.',
        s1Title: '1. Site publisher',
        s1Body:
          'This site is published by AgenStudio, an independent digital studio based in Cameroon (Douala / Yaoundé). Legal name, form and registration number: to be validated.',
        s1Contact: 'Email contact: contact@agenstudio.com',
        s2Title: '2. Hosting & infrastructure',
        s2Body:
          'Hosting: Cloudflare Pages (Cloudflare, Inc., San Francisco, CA, USA). Contact form: Cloudflare Turnstile and Resend — see the privacy policy.',
        s3Title: '3. Intellectual property',
        s3Body:
          'All content, visuals, interface concepts and source code are the exclusive property of AgenStudio unless explicitly stated otherwise.',
        s4Title: '4. Data controller',
        s4Body:
          'For contact form data: AgenStudio — full identity to be validated with legal counsel.',
      };
---

<Section variant="canvas" class="py-12 border-b border-ink/10">
  <Container>
    <div class="max-w-3xl space-y-3">
      <Tag variant="ink">{copy.kicker}</Tag>
      <h1 class="font-heading text-3xl sm:text-4xl font-bold text-ink">{copy.heading}</h1>
      <p class="text-sm font-mono text-teal">{copy.updated}</p>
    </div>
  </Container>
</Section>

<Section variant="white">
  <Container>
    <div class="max-w-prose space-y-6 text-sm text-ink-muted leading-relaxed">
      <h2 class="font-heading text-lg font-bold text-ink pt-2">{copy.s1Title}</h2>
      <p>
        {copy.s1Body}
        <br />
        <strong class="text-ink">{copy.s1Contact}</strong>
      </p>
      <h2 class="font-heading text-lg font-bold text-ink pt-2">{copy.s2Title}</h2>
      <p>{copy.s2Body}</p>
      <h2 class="font-heading text-lg font-bold text-ink pt-2">{copy.s3Title}</h2>
      <p>{copy.s3Body}</p>
      <h2 class="font-heading text-lg font-bold text-ink pt-2">{copy.s4Title}</h2>
      <p>{copy.s4Body}</p>
    </div>
  </Container>
</Section>
