---
import { translations, type Language } from '../../lib/i18n';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Tag from '../ui/Tag.astro';
import ContactForm from './ContactForm.tsx';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = translations[lang].contactForm;

const tagLabel = lang === 'fr' ? 'CONTACT & QUALIFICATION' : 'CONTACT & QUALIFICATION';
const directLabel = lang === 'fr' ? 'Contact direct' : 'Direct contact';
const emailHeading = lang === 'fr' ? 'Échange direct par e-mail' : 'Direct email exchange';
const engageLabel = lang === 'fr' ? 'Engagement de réponse' : 'Response commitment';
const engageBody =
  lang === 'fr'
    ? "Chaque demande fait l'objet d'un examen attentif. Nous vous recontactons sous 24h ouvrées avec une première proposition de cadrage."
    : 'Every inquiry is carefully reviewed. We reply within 24 business hours with an initial framing proposal.';
const privacyLabel = lang === 'fr' ? 'Confidentialité des échanges' : 'Conversation confidentiality';
const privacyBody =
  lang === 'fr'
    ? 'Vos informations opérationnelles restent strictement confidentielles et ne sont jamais transmises à des tiers.'
    : 'Your operational information remains strictly confidential and is never shared with third parties.';

const copy = {
  title: t.title,
  subtitle: t.subtitle,
  nameLabel: t.nameLabel,
  namePlaceholder: t.namePlaceholder,
  emailLabel: t.emailLabel,
  emailPlaceholder: t.emailPlaceholder,
  companyLabel: t.companyLabel,
  companyPlaceholder: t.companyPlaceholder,
  problemLabel: t.problemLabel,
  problemPlaceholder: t.problemPlaceholder,
  timelineLabel: t.timelineLabel,
  timelineOptions: t.timelineOptions,
  submitButton: t.submitButton,
  submitting: t.submitting,
  successMessage: t.successMessage,
  errorMessage: t.errorMessage,
  directEmailText: t.directEmailText,
  requiredLabel: lang === 'fr' ? 'Requis' : 'Required',
  againLabel: lang === 'fr' ? 'Envoyer une autre demande' : 'Submit another inquiry',
  successHeading:
    lang === 'fr' ? 'Demande transmise avec succès' : 'Inquiry submitted successfully',
};

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<Section variant="canvas" class="py-12 md:py-16 border-b border-ink/10">
  <Container>
    <div class="max-w-3xl space-y-4">
      <Tag variant="teal">{tagLabel}</Tag>
      <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-extrabold text-ink">
        {t.title}
      </h1>
      <p class="text-base sm:text-lg text-ink-muted leading-relaxed">{t.subtitle}</p>
    </div>
  </Container>
</Section>

<Section variant="white">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-8 bg-white border border-ink/10 rounded-2xl p-6 sm:p-10 shadow-sm">
        <ContactForm client:load lang={lang} copy={copy} turnstileSiteKey={turnstileSiteKey} />
      </div>

      <aside class="lg:col-span-4 space-y-6">
        <div class="bg-ink text-white p-6 rounded-2xl border border-teal/30 space-y-4">
          <div class="flex items-center gap-2 text-teal font-mono text-xs uppercase font-bold">
            <span aria-hidden="true">✉︎</span>
            <span>{directLabel}</span>
          </div>
          <h3 class="font-heading font-bold text-lg text-white">{emailHeading}</h3>
          <p class="text-xs text-ink-light leading-relaxed">{t.directEmailText}</p>
          <a
            href="mailto:contact@agenstudio.com"
            class="inline-block font-mono text-sm text-teal hover:underline font-bold break-all"
          >
            contact@agenstudio.com
          </a>
        </div>

        <div class="p-6 bg-canvas rounded-2xl border border-ink/10 space-y-3 text-xs text-ink-muted">
          <div class="flex items-center gap-2 text-ink font-bold">
            <span class="text-teal" aria-hidden="true">⏱</span>
            <span>{engageLabel}</span>
          </div>
          <p>{engageBody}</p>
        </div>

        <div class="p-6 bg-canvas rounded-2xl border border-ink/10 space-y-3 text-xs text-ink-muted">
          <div class="flex items-center gap-2 text-ink font-bold">
            <span class="text-teal" aria-hidden="true">🛡</span>
            <span>{privacyLabel}</span>
          </div>
          <p>{privacyBody}</p>
        </div>
      </aside>
    </div>
  </Container>
</Section>
