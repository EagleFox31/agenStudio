---
import { translations, type Language } from '../../lib/i18n';
import { projectPath } from '../../lib/routes';
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Tag from '../ui/Tag.astro';
import ProjectFilters from './ProjectFilters.tsx';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = translations[lang].projects;

const projects = (await getCollection('projects'))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);

const filterableProjects = projects.map((p) => ({
  slug: p.slug,
  type: p.type,
  href: projectPath(p.slug, lang),
  sector: p.sector[lang],
  typeLabel: t.types[p.type],
  title: p.title[lang],
  subtitle: p.subtitle[lang],
  friction: p.friction[lang],
  stack: p.stack,
  statusLabel: p.statusLabel[lang],
}));

const problemLabel = lang === 'fr' ? 'Ce qui coinçait' : 'What was jamming';
const filterLabel = lang === 'fr' ? 'Filtrer par statut' : 'Filter by status';
---

<Section variant="canvas" class="py-12 md:py-16 border-b border-ink/10">
  <Container>
    <div class="max-w-3xl space-y-4">
      <Tag variant="gold">{t.tag}</Tag>
      <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-extrabold text-ink">
        {t.title}
      </h1>
      <p class="text-base sm:text-lg text-ink-muted leading-relaxed">{t.subtitle}</p>
    </div>
  </Container>
</Section>

<Section variant="white">
  <Container>
    <ProjectFilters
      client:load
      lang={lang}
      allLabel={t.filterAll}
      filterLabel={filterLabel}
      projects={filterableProjects}
      typeLabels={t.types}
      problemLabel={problemLabel}
      viewLabel={t.viewCaseStudy}
    />
  </Container>
</Section>
