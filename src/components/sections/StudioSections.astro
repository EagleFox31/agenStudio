---
import { translations, type Language } from '../../lib/i18n';
import { route } from '../../lib/routes';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = translations[lang].studioIntro;
const cta = translations[lang].nav.ctaButton;
const contactHref = route('contact', lang);
---

<Section variant="canvas" class="py-12 md:py-20 border-b border-ink/10">
  <Container>
    <div class="max-w-3xl space-y-4">
      <Tag variant="teal">{t.tag}</Tag>
      <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-extrabold text-ink">
        {t.title}
      </h1>
      <p class="text-base sm:text-lg text-ink-muted leading-relaxed">{t.description}</p>
    </div>
  </Container>
</Section>

<Section variant="white">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-7 space-y-8">
        <div class="p-6 bg-ink text-white rounded-xl space-y-3 border border-teal/30">
          <div class="flex items-center gap-2 text-teal font-mono text-xs uppercase font-bold">
            <span aria-hidden="true">📍</span>
            <span>{t.craftKicker}</span>
          </div>
          <h2 class="font-heading text-lg font-bold text-white">{t.anchorage}</h2>
          <p class="text-xs text-ink-light leading-relaxed">{t.craftLead}</p>
        </div>
      </div>

      <div class="lg:col-span-5 space-y-6">
        {
          t.values.map((v) => (
            <Card variant="light" class="space-y-2">
              <div class="flex items-center gap-2 text-teal">
                <span aria-hidden="true">✓</span>
                <h2 class="font-heading font-bold text-base text-ink">{v.title}</h2>
              </div>
              <p class="text-xs text-ink-muted leading-relaxed pl-6">{v.desc}</p>
            </Card>
          ))
        }

        <div class="pt-4">
          <Button href={contactHref} variant="primary" class="w-full min-h-[44px]">
            {cta}
          </Button>
        </div>
      </div>
    </div>
  </Container>
</Section>
