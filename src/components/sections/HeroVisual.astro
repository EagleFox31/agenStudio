---
import { translations, type Language } from '../../lib/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const v = translations[lang].heroVisual;
---

<figure class="m-0">
  <div
    class="relative overflow-hidden rounded-2xl border border-ink/10 bg-teal min-h-[280px] sm:min-h-[360px] lg:min-h-[440px]"
  >
    <svg
      class="pointer-events-none absolute -right-[28%] -bottom-[18%] h-[130%] w-auto max-w-none"
      viewBox="0 0 64 64"
      aria-hidden="true"
      focusable="false"
    >
      <path class="fill-canvas" d="M32 14L48 48H39L32 32L25 48H16L32 14Z" />
      <path class="fill-teal-deep" d="M32 20L41 38H35L32 31L29 38H23L32 20Z" />
      <circle class="fill-magenta" cx="32" cy="24" r="3.5" />
      <line
        class="stroke-gold"
        x1="18"
        y1="42"
        x2="46"
        y2="42"
        stroke-width="2"
        stroke-dasharray="2 2"
      />
    </svg>

    <div class="relative z-10 flex h-full min-h-[280px] sm:min-h-[360px] lg:min-h-[440px] flex-col justify-between p-5 sm:p-6">
      <p class="max-w-[14rem] font-mono text-[11px] uppercase tracking-wider text-canvas/90">
        {v.mockLabel}
      </p>
      <p class="max-w-[16rem] font-heading text-lg sm:text-xl font-semibold leading-snug text-canvas">
        {v.mockCaption}
      </p>
    </div>
  </div>
  <figcaption class="mt-3 font-mono text-[11px] leading-relaxed text-ink/60">
    {v.visionFoot}
  </figcaption>
</figure>
