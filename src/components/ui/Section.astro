---
interface Props {
  id?: string;
  variant?: 'canvas' | 'white' | 'dark' | 'teal';
  class?: string;
}
const { id, variant = 'canvas', class: className = '' } = Astro.props;

const variants: Record<NonNullable<Props['variant']>, string> = {
  canvas: 'bg-canvas text-ink',
  white: 'bg-white text-ink',
  dark: 'bg-ink text-white',
  teal: 'bg-teal-deep text-white',
};
---

<section
  id={id}
  class:list={[
    'py-12 sm:py-16 md:py-24 lg:py-28 relative overflow-hidden',
    variants[variant],
    className,
  ]}
>
  <slot />
</section>
