---
interface Props {
  variant?:
    | 'teal'
    | 'ink'
    | 'magenta'
    | 'bordeaux'
    | 'bordeaux-light'
    | 'gold'
    | 'outline';
  class?: string;
}
const { variant = 'teal', class: className = '' } = Astro.props;

const variants: Record<NonNullable<Props['variant']>, string> = {
  teal: 'bg-teal/10 text-teal border border-teal/20',
  ink: 'bg-ink/10 text-ink border border-ink/20',
  magenta: 'bg-magenta/10 text-magenta border border-magenta/20',
  bordeaux: 'bg-bordeaux/10 text-bordeaux border border-bordeaux/25 font-semibold',
  'bordeaux-light':
    'bg-bordeaux/50 text-[#FFD6E0] border border-[#FFD6E0]/50 font-extrabold shadow-sm',
  gold: 'bg-gold/15 text-[#9E7519] border border-gold/30',
  outline: 'bg-transparent text-ink/70 border border-ink/20',
};
---

<span
  class:list={[
    'inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-mono tracking-wider uppercase',
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
