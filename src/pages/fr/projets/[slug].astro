---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectDetailSections from '../../../components/sections/ProjectDetailSections.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { project: entry.data },
  }));
}

const { project } = Astro.props;
---

<BaseLayout
  lang="fr"
  title={`${project.title.fr} — Étude de cas AgenStudio`}
  description={project.subtitle.fr}
>
  <ProjectDetailSections lang="fr" project={project} />
</BaseLayout>
