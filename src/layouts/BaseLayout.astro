---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import AnimatedBackground from '../components/ui/AnimatedBackground.astro';
import type { Language } from '../lib/i18n';
import { buildSeo, organizationJsonLd } from '../lib/seo';

interface Props {
  lang: Language;
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
}

const { lang, title, description, ogImage, noindex } = Astro.props;

const siteUrl = Astro.site?.toString() ?? 'https://agenstudio.com';
const seo = buildSeo(
  { title, description, path: Astro.url.pathname, lang, ogImage, noindex },
  siteUrl
);
const orgLd = organizationJsonLd(siteUrl);
const skipTo = lang === 'fr' ? 'Aller au contenu principal' : 'Skip to main content';
---

<!doctype html>
<html lang={lang === 'fr' ? 'fr-FR' : 'en-US'} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.svg" />
    <meta name="theme-color" content="#F7F4EE" />
    <meta name="color-scheme" content="light" />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    <link rel="alternate" hreflang="fr" href={seo.alternates.fr} />
    <link rel="alternate" hreflang="en" href={seo.alternates.en} />
    <link rel="alternate" hreflang="x-default" href={seo.alternates.fr} />

    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AgenStudio" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta
      property="og:locale:alternate"
      content={lang === 'fr' ? 'en_US' : 'fr_FR'}
    />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.ogImage} />

    <!-- Preconnect webfonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@400;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Serif:ital@1&display=swap"
    />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(orgLd)}
    />
  </head>

  <body class="min-h-screen flex flex-col bg-canvas text-ink relative">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 px-4 py-2 bg-teal text-white font-mono text-sm rounded shadow-lg"
    >
      {skipTo}
    </a>

    <AnimatedBackground />

    <Header lang={lang} pathname={Astro.url.pathname} />

    <main id="main-content" class="flex-grow pt-[72px] relative z-10">
      <slot />
    </main>

    <Footer lang={lang} />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
